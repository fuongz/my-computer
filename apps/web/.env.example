BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5174
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Base64 of 32 random bytes, shared with apps/api: this app seals a user's provider
# key with it on save, the API opens it to make one upstream call. Must be the same
# value in both Workers.
#   openssl rand -base64 32
PROVIDER_ENCRYPTION_KEY=

# The deployment's own Replicate token, the same value apps/api uses. Needed here too
# because opening the Generations gallery finishes any generation whose client gave up,
# and asking Replicate about a prediction started with the system key needs that key.
SYSTEM_REPLICATE_API_TOKEN=
