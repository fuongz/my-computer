# Names only, never values. Set these with `wrangler secret put <NAME>` in
# production, and in apps/api/.dev.vars (untracked) for local development.

# Must match apps/web exactly. A different secret means keys minted there cannot
# be verified here, and every request 401s.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Base64 of 32 random bytes, shared with apps/web: the web app seals a caller's
# provider key with it, this Worker opens it. Rotating it makes every stored
# credential unreadable, so treat it as permanent unless you plan a re-encrypt.
#   openssl rand -base64 32
PROVIDER_ENCRYPTION_KEY=

# The deployment's own provider keys, used only when a caller has none of their own
# (Default mode). Leave one blank and that provider is BYOK-only.
SYSTEM_OPENROUTER_API_KEY=
SYSTEM_REPLICATE_API_TOKEN=
