{
	"name": "@fuongz/webapp",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"//imports": "One alias, declared HERE and mirrored in tsconfig.json `paths`. Nowhere else — `#` is a Node subpath prefix that vite, rolldown and `bun run` all resolve natively, so a vite `resolve.alias` would be a third place to forget.",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 5174",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"deploy": "vite build && wrangler deploy",
		"data:sync": "bun run scripts/sync-mlbb-data.ts",
		"data:art": "bun run scripts/download-art.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@cloudflare/vite-plugin": "^1.51.1",
		"@fontsource-variable/geist": "^5.2.9",
		"@fontsource-variable/geist-mono": "^5.2.8",
		"@hugeicons/core-free-icons": "^4.2.1",
		"@hugeicons/react": "^1.1.7",
		"@tanstack/react-router": "^1.170.16",
		"@tanstack/react-start": "^1.168.26",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.1",
		"@types/bun": "latest",
		"@types/node": "^26.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"tailwindcss": "^4.3.1",
		"vite": "^8.0.16",
		"wrangler": "^4.120.0"
	}
}
