{
	"name": "fuongz-monorepo",
	"type": "module",
	"private": true,
	"version": "1.0.0",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "bun run --filter '*' build",
		"//dev": "There are two apps and no sensible default, so `dev` names one and each has its own script. Running both at once is two terminals, not one command.",
		"dev": "bun run --filter @fuongz/chrome-extension dev",
		"dev:webapp": "bun run --filter @fuongz/webapp dev",
		"deploy:webapp": "bun run --filter @fuongz/webapp deploy",
		"data:sync": "bun run --filter @fuongz/webapp data:sync",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "biome lint",
		"format": "biome format --write",
		"check": "biome check",
		"gate": "bun run build && bun run lint && bun run typecheck",
		"icons": "bun run --filter @fuongz/chrome-extension icons",
		"preview": "bun run --filter @fuongz/chrome-extension preview",
		"preview:popup": "bun run --filter @fuongz/chrome-extension preview:popup",
		"preview:task-name": "bun run --filter @fuongz/chrome-extension preview:task-name"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.3",
		"typescript": "^6.0.3"
	}
}
